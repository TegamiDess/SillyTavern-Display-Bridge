{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Display Bridge portable profile v1",
  "description": "Runtime validation additionally enforces unique IDs and field mappings, safe names, delimiter rules, total size and supported template grammar.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schemaVersion",
    "adapters"
  ],
  "properties": {
    "kind": {
      "const": "display-bridge-profile"
    },
    "schemaVersion": {
      "const": 1
    },
    "adapters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "version"
            ],
            "properties": {
              "id": {
                "enum": [
                  "media-panel",
                  "gallery"
                ]
              },
              "version": {
                "const": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "version",
              "source"
            ],
            "properties": {
              "id": {
                "const": "witchcure"
              },
              "version": {
                "const": 1
              },
              "source": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "roster",
                  "report",
                  "styles"
                ],
                "properties": {
                  "roster": {
                    "type": "string",
                    "maxLength": 500000
                  },
                  "report": {
                    "type": "string",
                    "maxLength": 500000
                  },
                  "styles": {
                    "type": "string",
                    "maxLength": 500000
                  },
                  "map": {
                    "type": "string",
                    "maxLength": 500000
                  },
                  "status": {
                    "type": "string",
                    "maxLength": 500000
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "version",
              "source"
            ],
            "properties": {
              "id": {
                "const": "witchcure"
              },
              "version": {
                "const": 2
              },
              "source": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "roster",
                  "report",
                  "styles"
                ],
                "properties": {
                  "roster": {
                    "type": "string",
                    "maxLength": 500000
                  },
                  "report": {
                    "type": "string",
                    "maxLength": 500000
                  },
                  "styles": {
                    "type": "string",
                    "maxLength": 500000
                  },
                  "map": {
                    "type": "string",
                    "maxLength": 500000
                  },
                  "status": {
                    "type": "string",
                    "maxLength": 500000
                  },
                  "autoRoster": {
                    "type": "boolean"
                  },
                  "cleanMoveTop": {
                    "type": "boolean"
                  },
                  "portraits": {
                    "type": "array",
                    "maxItems": 50,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "name",
                        "template"
                      ],
                      "properties": {
                        "name": {
                          "type": "string",
                          "pattern": "^[A-Za-z][A-Za-z .-]{0,79}$"
                        },
                        "template": {
                          "type": "string",
                          "maxLength": 10000
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "version",
              "source"
            ],
            "properties": {
              "id": {
                "const": "portrait-dialogue"
              },
              "version": {
                "enum": [
                  1,
                  2,
                  3,
                  4,
                  5
                ]
              },
              "source": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "format",
                  "variants"
                ],
                "properties": {
                  "format": {
                    "oneOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "kind",
                          "open",
                          "close",
                          "fields"
                        ],
                        "properties": {
                          "kind": {
                            "enum": [
                              "fields",
                              "json"
                            ]
                          },
                          "open": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 40
                          },
                          "close": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 40
                          },
                          "fields": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "speaker",
                              "dialogue",
                              "portrait"
                            ],
                            "properties": {
                              "speaker": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 60,
                                "pattern": "^[A-Za-z][\\w-]{0,59}$"
                              },
                              "dialogue": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 60,
                                "pattern": "^[A-Za-z][\\w-]{0,59}$"
                              },
                              "portrait": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 60,
                                "pattern": "^[A-Za-z][\\w-]{0,59}$"
                              },
                              "time": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 60,
                                "pattern": "^[A-Za-z][\\w-]{0,59}$"
                              },
                              "day": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 60,
                                "pattern": "^[A-Za-z][\\w-]{0,59}$"
                              },
                              "date": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 60,
                                "pattern": "^[A-Za-z][\\w-]{0,59}$"
                              },
                              "location": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 60,
                                "pattern": "^[A-Za-z][\\w-]{0,59}$"
                              }
                            }
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "kind",
                          "entries"
                        ],
                        "properties": {
                          "kind": {
                            "const": "tagged"
                          },
                          "entries": {
                            "type": "array",
                            "minItems": 1,
                            "maxItems": 64,
                            "items": {
                              "type": "object",
                              "additionalProperties": false,
                              "required": [
                                "kind"
                              ],
                              "properties": {
                                "kind": {
                                  "enum": [
                                    "dialogue",
                                    "dynamic",
                                    "narration",
                                    "status"
                                  ]
                                },
                                "tag": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 60
                                },
                                "quoted": {
                                  "type": "boolean"
                                },
                                "speaker": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 160
                                },
                                "portrait": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 256
                                },
                                "recent": {
                                  "type": "integer",
                                  "minimum": 1,
                                  "maximum": 100
                                },
                                "style": {
                                  "$ref": "#/$defs/presentationStyle"
                                },
                                "placement": {
                                  "const": "bottom"
                                }
                              },
                              "allOf": [
                                {
                                  "if": {
                                    "properties": {
                                      "kind": {
                                        "const": "dynamic"
                                      }
                                    }
                                  },
                                  "then": {
                                    "not": {
                                      "required": [
                                        "tag"
                                      ]
                                    }
                                  },
                                  "else": {
                                    "required": [
                                      "tag"
                                    ]
                                  }
                                },
                                {
                                  "if": {
                                    "properties": {
                                      "kind": {
                                        "enum": [
                                          "dialogue",
                                          "dynamic"
                                        ]
                                      }
                                    }
                                  },
                                  "then": {
                                    "required": [
                                      "speaker"
                                    ]
                                  }
                                },
                                {
                                  "if": {
                                    "properties": {
                                      "kind": {
                                        "const": "dialogue"
                                      }
                                    }
                                  },
                                  "then": {
                                    "required": [
                                      "portrait"
                                    ]
                                  }
                                },
                                {
                                  "if": {
                                    "properties": {
                                      "kind": {
                                        "const": "status"
                                      }
                                    }
                                  },
                                  "then": {
                                    "not": {
                                      "required": [
                                        "style"
                                      ]
                                    }
                                  },
                                  "else": {
                                    "not": {
                                      "required": [
                                        "placement"
                                      ]
                                    }
                                  }
                                }
                              ]
                            }
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "kind"
                        ],
                        "properties": {
                          "kind": {
                            "const": "community"
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "kind",
                          "open",
                          "close"
                        ],
                        "properties": {
                          "kind": {
                            "const": "scene"
                          },
                          "open": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 40
                          },
                          "close": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 40
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "kind",
                          "backgrounds",
                          "castFields",
                          "counts",
                          "dialogueOpeners",
                          "textTags"
                        ],
                        "properties": {
                          "kind": {
                            "const": "scene-fragments"
                          },
                          "backgrounds": {
                            "type": "array",
                            "minItems": 1,
                            "maxItems": 3,
                            "uniqueItems": true,
                            "items": {
                              "enum": [
                                "numbered-four",
                                "plain-four",
                                "numbered-five"
                              ]
                            }
                          },
                          "castFields": {
                            "enum": [
                              2,
                              4
                            ]
                          },
                          "counts": {
                            "type": "array",
                            "minItems": 1,
                            "maxItems": 5,
                            "uniqueItems": true,
                            "items": {
                              "enum": [
                                0,
                                1,
                                2,
                                3,
                                4
                              ]
                            }
                          },
                          "dialogueOpeners": {
                            "type": "array",
                            "minItems": 1,
                            "maxItems": 2,
                            "uniqueItems": true,
                            "items": {
                              "enum": [
                                "single",
                                "double"
                              ]
                            }
                          },
                          "textTags": {
                            "type": "boolean"
                          }
                        }
                      }
                    ]
                  },
                  "variantLabel": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60
                  },
                  "variants": {
                    "type": "array",
                    "maxItems": 32,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "id",
                        "label",
                        "images"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 60,
                          "pattern": "^[A-Za-z][\\w-]{0,59}$"
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 80
                        },
                        "images": {
                          "type": "object",
                          "maxProperties": 200,
                          "propertyNames": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 256
                          },
                          "additionalProperties": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 256
                          }
                        }
                      }
                    }
                  },
                  "theme": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [],
                    "properties": {
                      "accent": {
                        "type": "string",
                        "pattern": "^#[a-fA-F0-9]{6}$"
                      },
                      "background": {
                        "type": "string",
                        "pattern": "^#[a-fA-F0-9]{6}$"
                      },
                      "text": {
                        "type": "string",
                        "pattern": "^#[a-fA-F0-9]{6}$"
                      },
                      "pattern": {
                        "enum": [
                          "plain",
                          "gingham"
                        ]
                      },
                      "position": {
                        "enum": [
                          "left",
                          "center",
                          "right"
                        ]
                      }
                    }
                  },
                  "imageMappings": {
                    "type": "object",
                    "maxProperties": 200,
                    "propertyNames": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256,
                      "not": {
                        "enum": [
                          "__proto__",
                          "prototype",
                          "constructor"
                        ]
                      }
                    },
                    "additionalProperties": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  },
                  "metadataLabels": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "time": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 40
                      },
                      "day": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 40
                      },
                      "date": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 40
                      },
                      "location": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 40
                      }
                    }
                  },
                  "defaults": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "visual": {
                        "type": "boolean"
                      },
                      "image": {
                        "type": "boolean"
                      },
                      "dialogue": {
                        "type": "boolean"
                      },
                      "console": {
                        "type": "boolean"
                      }
                    }
                  },
                  "portraitLabels": {
                    "type": "object",
                    "maxProperties": 200,
                    "propertyNames": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256,
                      "not": {
                        "enum": [
                          "__proto__",
                          "prototype",
                          "constructor"
                        ]
                      }
                    },
                    "additionalProperties": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    }
                  },
                  "appearance": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "allowOriginal",
                      "defaultVariant"
                    ],
                    "properties": {
                      "allowOriginal": {
                        "type": "boolean"
                      },
                      "defaultVariant": {
                        "type": "string",
                        "pattern": "^[A-Za-z][\\w-]{0,59}$"
                      }
                    },
                    "description": "Runtime requires defaultVariant to name an existing variant, or original only when allowOriginal is true.",
                    "allOf": [
                      {
                        "if": {
                          "properties": {
                            "allowOriginal": {
                              "const": false
                            }
                          }
                        },
                        "then": {
                          "properties": {
                            "defaultVariant": {
                              "not": {
                                "const": "original"
                              }
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "version": {
                      "const": 1
                    }
                  }
                },
                "then": {
                  "properties": {
                    "source": {
                      "properties": {
                        "format": {
                          "properties": {
                            "entries": {
                              "items": {
                                "not": {
                                  "anyOf": [
                                    {
                                      "required": [
                                        "style"
                                      ]
                                    },
                                    {
                                      "required": [
                                        "placement"
                                      ]
                                    }
                                  ]
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "version": {
                      "enum": [
                        1,
                        2
                      ]
                    }
                  }
                },
                "then": {
                  "properties": {
                    "source": {
                      "not": {
                        "anyOf": [
                          {
                            "required": [
                              "imageMappings"
                            ]
                          },
                          {
                            "required": [
                              "metadataLabels"
                            ]
                          },
                          {
                            "required": [
                              "defaults"
                            ]
                          }
                        ]
                      }
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "version": {
                      "enum": [
                        1,
                        2,
                        3
                      ]
                    }
                  }
                },
                "then": {
                  "properties": {
                    "source": {
                      "properties": {
                        "format": {
                          "not": {
                            "properties": {
                              "kind": {
                                "const": "scene-fragments"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "version": {
                      "enum": [
                        1,
                        2,
                        3,
                        4
                      ]
                    }
                  }
                },
                "then": {
                  "properties": {
                    "source": {
                      "not": {
                        "anyOf": [
                          {
                            "required": [
                              "appearance"
                            ]
                          },
                          {
                            "required": [
                              "portraitLabels"
                            ]
                          }
                        ]
                      }
                    }
                  }
                }
              }
            ]
          }
        ]
      }
    }
  },
  "$defs": {
    "presentationStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "accent": {
          "type": "string",
          "pattern": "^#[a-fA-F0-9]{6}$"
        },
        "background": {
          "type": "string",
          "pattern": "^#[a-fA-F0-9]{6}$"
        },
        "backgroundEnd": {
          "type": "string",
          "pattern": "^#[a-fA-F0-9]{6}$"
        },
        "text": {
          "type": "string",
          "pattern": "^#[a-fA-F0-9]{6}$"
        },
        "nameBackground": {
          "type": "string",
          "pattern": "^#[a-fA-F0-9]{6}$"
        },
        "nameText": {
          "type": "string",
          "pattern": "^#[a-fA-F0-9]{6}$"
        },
        "borderWidth": {
          "type": "number",
          "minimum": 0,
          "maximum": 8
        },
        "radius": {
          "type": "number",
          "minimum": 0,
          "maximum": 40
        },
        "padX": {
          "type": "number",
          "minimum": 8,
          "maximum": 48
        },
        "padY": {
          "type": "number",
          "minimum": 8,
          "maximum": 36
        },
        "fontSize": {
          "type": "number",
          "minimum": 12,
          "maximum": 24
        },
        "lineHeight": {
          "type": "number",
          "minimum": 1.2,
          "maximum": 2
        },
        "fontWeight": {
          "type": "number",
          "minimum": 400,
          "maximum": 800
        },
        "nameFontSize": {
          "type": "number",
          "minimum": 11,
          "maximum": 22
        },
        "nameTilt": {
          "type": "number",
          "minimum": -5,
          "maximum": 5
        },
        "width": {
          "type": "number",
          "minimum": 50,
          "maximum": 100
        },
        "stageHeight": {
          "type": "string",
          "pattern": "^\\d+(?:\\.\\d+)?(px|vh)$",
          "description": "Runtime enforces the unit-specific numeric bounds documented in PRESENTATION-STYLES.md."
        },
        "portraitHeight": {
          "type": "string",
          "pattern": "^\\d+(?:\\.\\d+)?(px|vh)$",
          "description": "Runtime enforces the unit-specific numeric bounds documented in PRESENTATION-STYLES.md."
        },
        "portraitWidth": {
          "type": "string",
          "pattern": "^\\d+(?:\\.\\d+)?(px|vw|%)$",
          "description": "Runtime enforces the unit-specific numeric bounds documented in PRESENTATION-STYLES.md."
        },
        "pattern": {
          "enum": [
            "plain",
            "gingham"
          ]
        }
      }
    }
  }
}

{
  "kind": "display-bridge-profile",
  "schemaVersion": 1,
  "adapters": [
    {
      "id": "portrait-dialogue",
      "version": 10,
      "source": {
        "format": {
          "kind": "scene-fragments",
          "backgrounds": [
            "numbered-four"
          ],
          "castFields": 4,
          "counts": [
            0,
            1,
            2,
            3,
            4
          ],
          "dialogueOpeners": [
            "double"
          ],
          "textTags": true,
          "details": {
            "version": 1,
            "castMetadata": true,
            "layers": true,
            "periodAssets": {
              "sky": "night"
            },
            "offsetAliases": {
              "@guide": "20%",
              "@curator": "20%"
            }
          },
          "normalization": {
            "version": 1,
            "counts": {
              "5": 2
            },
            "assets": [
              {
                "from": [
                  "helper"
                ],
                "to": "guide"
              }
            ],
            "backgrounds": [
              {
                "from": [
                  "BG_observatory_daytime.png",
                  "BG_observatory_dusk.png",
                  "BG_observatory_night.png",
                  "BG_observatory_midnight.png"
                ],
                "to": "BG_observatory.png"
              }
            ]
          }
        },
        "variantLabel": "Appearance",
        "variants": [],
        "theme": {
          "accent": "#8499b1",
          "background": "#26313e",
          "text": "#f2f4f8",
          "pattern": "plain",
          "position": "center"
        },
        "sceneControls": {
          "version": 1,
          "roster": {
            "title": "Character information",
            "entities": [
              {
                "id": "guide",
                "label": "guide",
                "portrait": "guide1_icon.png",
                "badges": [
                  {
                    "id": "badge0",
                    "label": "New",
                    "image": "guide1_icon.png"
                  },
                  {
                    "id": "badge1",
                    "label": "Friend",
                    "image": "guide2_icon.png"
                  }
                ]
              },
              {
                "id": "curator",
                "label": "curator",
                "portrait": "curator1_icon.png",
                "badges": [
                  {
                    "id": "badge0",
                    "label": "New",
                    "image": "curator1_icon.png"
                  },
                  {
                    "id": "badge1",
                    "label": "Friend",
                    "image": "curator2_icon.png"
                  }
                ]
              }
            ]
          },
          "music": {
            "title": "Scene music",
            "tracks": [
              {
                "id": "track1",
                "label": "evening-chime",
                "asset": "evening-chime"
              },
              {
                "id": "track2",
                "label": "morning-chime",
                "asset": "morning-chime"
              }
            ],
            "volume": 0.3,
            "loop": true
          }
        },
        "sceneState": {
          "version": 3,
          "variables": {
            "guide_p": {
              "type": "number",
              "initial": 5,
              "min": -1000000,
              "max": 1000000
            },
            "guide_loc": {
              "type": "string",
              "initial": "Observatory"
            },
            "guide_r": {
              "type": "string",
              "initial": "New"
            },
            "curator_p": {
              "type": "number",
              "initial": 5,
              "min": -1000000,
              "max": 1000000
            },
            "curator_loc": {
              "type": "string",
              "initial": "Observatory"
            },
            "curator_r": {
              "type": "string",
              "initial": "New"
            },
            "guide_badge": {
              "type": "enum",
              "initial": null,
              "values": [
                "badge0",
                "badge1"
              ]
            },
            "curator_badge": {
              "type": "enum",
              "initial": null,
              "values": [
                "badge0",
                "badge1"
              ]
            },
            "sceneTrack": {
              "type": "enum",
              "initial": "track1",
              "values": [
                "track1",
                "track2"
              ]
            }
          },
          "rules": [
            {
              "template": "<MOVE_{entity}_{value}>",
              "op": "set",
              "targets": {
                "guide": "guide_loc",
                "curator": "curator_loc"
              },
              "insensitive": true
            },
            {
              "template": "<관계={entity}={value}>",
              "op": "set",
              "targets": {
                "guide": "guide_r",
                "curator": "curator_r"
              },
              "values": {
                "New": "New",
                "Friend": "Friend"
              }
            },
            {
              "template": "<❤{entity}+{value}>",
              "op": "add",
              "targets": {
                "guide": "guide_p",
                "curator": "curator_p"
              },
              "valueFormat": "unsigned-integer"
            },
            {
              "template": "<❤{entity}-{value}>",
              "op": "subtract",
              "targets": {
                "guide": "guide_p",
                "curator": "curator_p"
              },
              "valueFormat": "unsigned-integer"
            }
          ],
          "derive": [
            {
              "from": "guide_r",
              "to": "guide_badge",
              "values": {
                "New": "badge0",
                "Friend": "badge1"
              }
            },
            {
              "from": "curator_r",
              "to": "curator_badge",
              "values": {
                "New": "badge0",
                "Friend": "badge1"
              }
            }
          ],
          "roster": [
            {
              "id": "guide",
              "score": "guide_p",
              "location": "guide_loc",
              "relationship": "guide_r",
              "badge": "guide_badge"
            },
            {
              "id": "curator",
              "score": "curator_p",
              "location": "curator_loc",
              "relationship": "curator_r",
              "badge": "curator_badge"
            }
          ],
          "track": "sceneTrack",
          "literals": [
            {
              "text": "<BGM=@BGM_01_Evening>",
              "key": "sceneTrack",
              "value": "track1"
            },
            {
              "text": "<BGM=@BGM_02_Evening>",
              "key": "sceneTrack",
              "value": "track2"
            },
            {
              "text": "<BGM=@BGM_01_Morning>",
              "key": "sceneTrack",
              "value": "track1"
            },
            {
              "text": "<BGM=@BGM_02_Morning>",
              "key": "sceneTrack",
              "value": "track2"
            },
            {
              "text": "@BGMoff",
              "key": "sceneTrack",
              "value": null
            },
            {
              "text": "<@BGMoff>",
              "key": "sceneTrack",
              "value": null
            },
            {
              "text": "<@BGM=BGMoff>",
              "key": "sceneTrack",
              "value": null
            }
          ],
          "strictPrefixes": [
            "<BGM=@BGM_"
          ],
          "context": {
            "title": "Current scene facts",
            "fields": [
              {
                "key": "guide_p",
                "label": "guide score"
              },
              {
                "key": "guide_loc",
                "label": "guide location"
              },
              {
                "key": "guide_r",
                "label": "guide relationship"
              },
              {
                "key": "curator_p",
                "label": "curator score"
              },
              {
                "key": "curator_loc",
                "label": "curator location"
              },
              {
                "key": "curator_r",
                "label": "curator relationship"
              }
            ]
          },
          "request": {
            "version": 1,
            "greetingVariable": "fm",
            "marker": "&&&",
            "template": "\nCurrent guides: [guide / score={guide_p} / location={guide_loc} / relationship={guide_r}] [curator / score={curator_p} / location={curator_loc} / relationship={curator_r}]. Keep these facts consistent and emit declared update annotations when they change."
          }
        }
      }
    }
  ]
}
